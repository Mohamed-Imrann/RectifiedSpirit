import logging
logger = logging.getLogger(__name__)
logger.setLevel(logging.INFO)

from pyrogram import Client, filters
from pyrogram.types import Message, InlineKeyboardMarkup, InlineKeyboardButton, CallbackQuery
from info import REQ_CHANNEL_ONE, REQ_CHANNEL_TWO, ADMINS
from database.request_forcesub_db import is_requested_one, is_requested_two, add_req_one, add_req_two, delete_all_one, delete_all_two
from database.join_reqs import JoinReqs
from utils import temp

@Client.on_message(filters.command("setfsub1") & filters.user(ADMINS))
async def set_fsub_channel_one(client, message: Message):
    if len(message.command) &lt; 2:
        return await message.reply_text("Usage: /setfsub1 [channel_id]")
    
    channel_id = int(message.command[1])
    
    try:
        chat = await client.get_chat(channel_id)
        if not chat.invite_link:
            await message.reply_text("Bot needs to be an admin in the channel with 'Invite Users via Link' permission to create an invite link.")
            return
        
        await JoinReqs().add_fsub_chat1(channel_id)
        temp.LINK_ONE = (await client.create_chat_invite_link(chat_id=channel_id, creates_join_request=True)).invite_link
        await message.reply_text(f"Force subscribe channel 1 set to: {chat.title} (`{channel_id}`)")
    except Exception as e:
        await message.reply_text(f"Error setting channel: {e}")

