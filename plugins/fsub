@Client.on_message(filters.command("delfsub1") & filters.user(ADMINS))
async def del_fsub_channel_one(client, message: Message):
    if REQ_CHANNEL_ONE:
        await JoinReqs().delete_fsub_chat1(REQ_CHANNEL_ONE)
        temp.LINK_ONE = None
        await message.reply_text("Force subscribe channel 1 removed.")
    else:
        await message.reply_text("No force subscribe channel 1 is currently set.")

