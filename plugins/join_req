@Client.on_chat_join_request()
async def handle_join_request(client: Client, join_request: ChatJoinRequest):
    # Log the join request
    print(f"New join request from {join_request.from_user.first_name} ({join_request.from_user.id}) for chat {join_request.chat.title} ({join_request.chat.id})")
    
    # Example: Automatically approve if user is an admin
    if join_request.from_user.id in ADMINS:
        await join_request.approve()
        print(f"Approved join request for admin {join_request.from_user.first_name}")
    else:
        # Store the request in DB for manual approval or other logic
        await db().add_user(
            user_id=join_request.from_user.id,
            first_name=join_request.from_user.first_name,
            username=join_request.from_user.username,
            date=join_request.date
        )
        print(f"Stored join request for {join_request.from_user.first_name}")
