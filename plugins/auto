@Client.on_message(filters.text & filters.group & filters.incoming & filters.channel & ~filters.edited & filters.chat(CHANNELS) if CHANNELS else filters.group & filters.incoming & ~filters.edited)
async def give_filter(client, message):
    if message.text.startswith("/"):
        return

    group_id = message.chat.id
    settings = await get_settings(group_id)
    if settings['button']:
        if not settings['botpm']:
            if not await is_subscribed(client, message):
                await message.reply_text(
                    text="**You are not subscribed to our channel. Please join to use this bot.**",
                    reply_markup=InlineKeyboardMarkup([
                        [InlineKeyboardButton("Join Channel", url=f"https://t.me/{AUTH_CHANNEL}")]
                    ])
                )
                return

        query = message.text.strip()
        files, offset, total_results = await get_search_results(query, file_type="document", max_results=10)
        if files:
            reply_markup = []
            for file in files:
                reply_markup.append([InlineKeyboardButton(file.file_name, callback_data=f"files#{file.file_id}")])
            
            if offset != "":
                reply_markup.append([InlineKeyboardButton("Next ➡️", callback_data=f"next_{offset}_{query}")])
            
            reply_markup.append([InlineKeyboardButton("Close", callback_data="close_data")])
            
            await message.reply_text(
                f"Found {total_results} results for '{query}':",
                reply_markup=InlineKeyboardMarkup(reply_markup)
            )
        else:
            if settings['spell_check']:
                await message.reply_text(script.SPELL_TEXT)
            else:
                await message.reply_text("No results found.")
    else:
        # If button mode is off, just send the first file directly
        query = message.text.strip()
        files, offset, total_results = await get_search_results(query, file_type="document", max_results=1)
        if files:
            file_details = files[0]
            try:
                if PUBLIC_FILE_STORE:
                    await client.send_cached_media(
                        chat_id=message.chat.id,
                        file_id=file_details.file_id,
                        caption=CUSTOM_FILE_CAPTION.format(previouscaption=file_details.caption) if CUSTOM_FILE_CAPTION else file_details.caption,
                        protect_content=PROTECT_CONTENT
                    )
                else:
                    await message.reply_cached_media(
                        file_id=file_details.file_id,
                        caption=CUSTOM_FILE_CAPTION.format(previouscaption=file_details.caption) if CUSTOM_FILE_CAPTION else file_details.caption,
                        protect_content=PROTECT_CONTENT
                    )
            except Exception as e:
                logger.error(f"Error sending file: {e}")
                await message.reply_text("Failed to send file.")
        else:
            if settings['spell_check']:
                await message.reply_text(script.SPELL_TEXT)
            else:
                await message.reply_text("No results found.")

