@Client.on_callback_query(filters.regex("^next"))
async def next_page(client, callback_query: CallbackQuery):
    ident, offset, query = callback_query.data.split("_")
    files, n_offset, total_results = await get_search_results(query, file_type="document", max_results=10, offset=int(offset))
    if not files:
        await callback_query.answer("No more files found.", show_alert=True)
        return
    
    reply_markup = []
    for file in files:
        reply_markup.append([InlineKeyboardButton(file.file_name, callback_data=f"files#{file.file_id}")])
    
    if n_offset != "":
        reply_markup.append([InlineKeyboardButton("Next ➡️", callback_data=f"next_{n_offset}_{query}")])
    
    reply_markup.append([InlineKeyboardButton("Close", callback_data="close_data")])
    
    try:
        await callback_query.message.edit_reply_markup(
            reply_markup=InlineKeyboardMarkup(reply_markup)
        )
    except MessageNotModified:
        pass
    await callback_query.answer()

@Client.on_callback_query(filters.regex("^files#"))
async def send_file_from_callback(client, callback_query: CallbackQuery):
    file_id = callback_query.data.split("#")[1]
    file_details = await get_file_details(file_id)
    if not file_details:
        await callback_query.answer("File not found.", show_alert=True)
        return
    
    file_details = file_details[0]
    
    try:
        if PUBLIC_FILE_STORE:
            await client.send_cached_media(
                chat_id=callback_query.message.chat.id,
                file_id=file_details.file_id,
                caption=CUSTOM_FILE_CAPTION.format(previouscaption=file_details.caption) if CUSTOM_FILE_CAPTION else file_details.caption,
                protect_content=PROTECT_CONTENT
            )
        else:
            await callback_query.message.reply_cached_media(
                file_id=file_details.file_id,
                caption=CUSTOM_FILE_CAPTION.format(previouscaption=file_details.caption) if CUSTOM_FILE_CAPTION else file_details.caption,
                protect_content=PROTECT_CONTENT
            )
    except Exception as e:
        logger.error(f"Error sending file from callback: {e}")
        await callback_query.answer("Failed to send file.", show_alert=True)
    
    await callback_query.answer()

@Client.on_callback_query(filters.regex("^close_data$"))
async def close_data_callback(client, callback_query: CallbackQuery):
    await callback_query.message.delete()
    await callback_query.answer()
